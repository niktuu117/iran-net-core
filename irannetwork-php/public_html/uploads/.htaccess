# Allow image files to be served, but block any script execution.
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|pl|py|cgi|sh|asp|aspx|exe)$">
    Require all denied
</FilesMatch>

# Hide dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7
RemoveType    .php .phtml .php3 .php4 .php5 .php7
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .pl .py .cgi
